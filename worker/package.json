{
  "name": "mewroute-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx build/build.ts",
    "dev": "tsx build/build.ts && wrangler kv key put manifest --path=.mewroute/manifest.json --binding=MANIFEST --local && wrangler dev",
    "deploy": "tsx build/deploy.ts",
    "sync-config": "tsx build/deploy.ts --config-only",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "marked": "^18.2.1",
    "marked-gfm-heading-id": "^4.1.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
